# SQLite database path (default is data/north_star.db when omitted)
# DATABASE_URL=sqlite:///data/north_star.db

# Dedalus Labs API key (required for transcript analysis)
DEDALUS_API_KEY=

# Optional: override the default model
# LLM_MODEL=openai/gpt-4o-mini

# Comma-separated hostnames accepted by TrustedHostMiddleware in production.
# Example: TRUSTED_HOSTS=beta.penelope.livetheresidency.com,127.0.0.1,localhost
# TRUSTED_HOSTS=

# Optional CORS allowlist for cross-origin frontend/API use.
# Example: CORS_ALLOW_ORIGINS=https://beta.penelope.livetheresidency.com
# CORS_ALLOW_ORIGINS=

# Set to true when serving the site over HTTPS to mark auth cookies secure.
# SESSION_COOKIE_SECURE=false

# Optional cookie domain override. Leave unset for host-only cookies.
# SESSION_COOKIE_DOMAIN=

# Optional comma-separated username allowlist for issuing/revoking magic login links.
# When unset, any authenticated account can issue/revoke links.
# MAGIC_LINK_ADMIN_USERNAMES=
